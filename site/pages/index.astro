---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import Principles from '../components/Principles.astro';
import { withBase } from '../lib/base.mjs';
import { DISCORD_INVITE } from '../lib/links.mjs';

const discordUrl = DISCORD_INVITE;

const competitions = (await getCollection('competitions'))
  .filter((entry) => entry.data.kind === 'competition')
  .sort((a, b) => a.data.order - b.data.order);

// The home page shows only the opening of getting-started. Everything past the sentinel is the
// competitions table, which would sit directly above the card grid saying the same thing.
// Split the rendered HTML rather than the source so this uses Astro's own markdown pipeline.
const gettingStarted = await getEntry('pages', 'getting-started');
const homeExcerpt = gettingStarted.rendered.html.split('<!-- home-excerpt-end -->')[0];
---
<Base>
  <section class="home-hero">
    <div class="home-hero-copy">
      <img class="badge" src={withBase("/brand/lion.png")} alt="STROH's crest" />
      <h1>Welcome to STROH's</h1>
      <p class="tagline">The South Texas Roost of Hospitality — a friendly, easily-accessible way for No Laying Up Refuge members (and their friends) to get out, meet people, and play golf across Austin, Houston, and San Antonio.</p>
      <div class="hero-actions">
        <a class="btn" href={discordUrl}>Join the Discord</a>
        <a class="btn secondary" href="#competitions">Explore our Competitions</a>
      </div>
    </div>
    <div class="home-hero-gallery">
      <Gallery />
    </div>
  </section>

  <Principles principles={gettingStarted.data.principles} />

  <h2 id="competitions">The Competitions</h2>
  <p>Four qualifiers feed our Roost Regional team (and the NIT) — plus the Texas Cup for bragging rights. Here's the lineup:</p>
  <div class="cards">
    {competitions.map(({ data }) => (
      <a class="card" href={withBase(`/competitions/${data.slug}`)} style={`--accent:${data.accent};`}>
        <img class="comp-logo" src={withBase(data.logo)} alt={data.title} />
        <h3>{data.title}</h3>
        <p>{data.blurb}</p>
        <span class="view">View →</span>
      </a>
    ))}
  </div>

  <div class="prose" set:html={homeExcerpt} />
</Base>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }
  .home-hero-copy {
    text-align: center;
  }
  .home-hero-copy .badge {
    height: 168px;
    width: auto;
    display: block;
    margin: 0 auto 16px;
  }
  .home-hero-gallery {
    padding-top: 12px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .comp-logo {
    height: 64px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    margin: 0 auto 10px;
    display: block;
  }
  @media (max-width: 820px) {
    .home-hero {
      grid-template-columns: 1fr;
    }
  }
</style>
