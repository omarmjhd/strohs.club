---
// Renders published Google Sheets as native tables. The CSV endpoint sends
// access-control-allow-origin: *, so the browser fetches it directly — the board stays as
// live as the sheet without a rebuild, and it looks like the rest of the site rather than
// an embedded iframe.
const { csvBase, boards = [], sheetUrl, hideColumns = [], sheetLabel = "source sheet" } = Astro.props;
---
{boards.length > 0 && (
  <div class="standings" data-standings data-csv-base={csvBase} data-hide={hideColumns.join("|")}>
    {boards.map((b, i) => (
      <details class="board" data-gid={b.gid} data-mode={b.mode ?? 'sections'}
        data-require={(b.requireColumns ?? []).join("|")}
        data-cut={b.cut ? `${b.cut.bye}|${b.cut.playoff}` : ''} open={i === 0}>
        <summary>{b.title}</summary>
        <div class="board-body"><p class="board-status">Loading…</p></div>
      </details>
    ))}
    {sheetUrl && (
      <p class="board-source">
        Live from the <a href={sheetUrl} rel="noopener">{sheetLabel}</a>.
      </p>
    )}
  </div>
)}

<!-- Tables are built by the client script, so they never receive Astro's scoping
     attribute. These styles must be global; every selector is prefixed with .standings
     to keep them contained, and table-qualified to outrank `.prose td` in global.css. -->
<style is:global>
  .standings { margin: 18px 0; }
  .standings .board {
    border: 1px solid #c9cfdd; border-radius: 10px; margin-bottom: 10px; background: #fff;
  }
  .standings .board > summary {
    cursor: pointer; padding: 11px 14px; font-weight: 700; color: #002060; list-style: none;
  }
  .standings .board > summary::-webkit-details-marker { display: none; }
  .standings .board > summary::before { content: '\25B8  '; color: #C00840; }
  .standings .board[open] > summary::before { content: '\25BE  '; }
  .standings .board[open] > summary { border-bottom: 1px solid #e4e8f0; }
  .standings .board-body { padding: 0 14px 12px; overflow-x: auto; }
  .standings .board-status { color: #8a8a99; font-size: 0.9rem; margin: 10px 0; }

  .standings table {
    border-collapse: collapse; width: 100%; margin: 8px 0 16px;
    font-size: 0.92rem; border: 1px solid #b9c1d4;
  }
  .standings table th {
    background: #002060; color: #fff; text-align: center;
    padding: 8px 9px; font-weight: 600; line-height: 1.25;
    border: 1px solid #4a5f8f;
  }
  /* Wide boards: let long headers stack rather than force a long horizontal scroll. */
  .standings table.wide th { font-size: .82rem; padding: 7px 6px; }
  .standings table.wide td { padding: 6px 6px; font-size: .89rem; }
  .standings table td {
    padding: 7px 10px; border: 1px solid #ccd3e0; color: #1A1A2E;
  }
  .standings table tbody tr:nth-child(even) { background: #f4f6fb; }
  .standings table tbody tr:hover { background: #e9eefa; }
  .standings table td.num { text-align: center; white-space: nowrap; }

  /* Cut lines: who gets a bye, who makes the bracket. */
  .standings table tbody tr.is-bye { background: #fdf3d6; box-shadow: inset 4px 0 0 #C9A227; }
  .standings table tbody tr.is-playoff { background: #eaf2ff; box-shadow: inset 4px 0 0 #0078C0; }
  .standings table tbody tr.is-bye:hover { background: #fbecc2; }
  .standings table tbody tr.is-playoff:hover { background: #dde9fb; }
  .standings .cut-legend {
    display: flex; flex-wrap: wrap; gap: 16px; margin: 10px 0 2px;
    font-size: .84rem; color: #4a4a5a;
  }
  .standings .cut-legend .sw {
    display: inline-block; width: 11px; height: 11px; border-radius: 3px; margin-right: 6px;
    vertical-align: -1px;
  }
  .standings .cut-legend .sw.bye { background: #C9A227; }
  .standings .cut-legend .sw.play { background: #0078C0; }

  .standings .bracket { margin-top: 18px; }
  .standings .bracket-note { font-size: .84rem; color: #6b6b7b; margin: 0 0 10px; }
  .standings .rounds { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .standings .rounds .rd h5 {
    margin: 0 0 8px; font-size: .74rem; text-transform: uppercase; letter-spacing: .06em;
    color: #002060; border-bottom: 2px solid #C00840; padding-bottom: 4px;
  }
  .standings .rounds .mt {
    border: 1px solid #ccd3e0; border-radius: 7px; margin-bottom: 8px;
    font-size: .82rem; background: #fff; overflow: hidden;
  }
  .standings .rounds .mt > div { padding: 5px 8px; }
  .standings .rounds .mt > div:first-child { border-bottom: 1px solid #e4e8f0; }
  .standings .rounds .mt b { color: #002060; margin-right: 4px; }
  .standings .rounds .mt i { color: #7b8194; font-style: normal; }
  @media (max-width: 700px) {
    .standings .rounds { grid-template-columns: 1fr 1fr; }
  }

  .standings h4 {
    margin: 16px 0 4px; text-transform: uppercase; letter-spacing: .05em;
    font-size: .8rem; color: #C00840;
  }
  .standings .board-source { font-size: .85rem; color: #6b6b7b; }
</style>

<script>
  const parseCsv = (text) => {
    const rows = [];
    let row = [], field = '', quoted = false;
    for (let i = 0; i < text.length; i++) {
      const c = text[i];
      if (quoted) {
        if (c === '"' && text[i + 1] === '"') { field += '"'; i++; }
        else if (c === '"') quoted = false;
        else field += c;
      } else if (c === '"') quoted = true;
      else if (c === ',') { row.push(field); field = ''; }
      else if (c === '\n') { row.push(field); rows.push(row); row = []; field = ''; }
      else if (c !== '\r') field += c;
    }
    if (field || row.length) { row.push(field); rows.push(row); }
    return rows;
  };

  // Sheet formulas pad unused rows with '-' in the computed columns, so a row is only
  // data if something in it is neither blank nor a placeholder.
  const PLACEHOLDER = /^[-–—]$/;
  const filled = (r) => r.some((c) => c.trim() !== '' && !PLACEHOLDER.test(c.trim()));
  const el = (tag, text) => { const n = document.createElement(tag); if (text != null) n.textContent = text; return n; };

  function table(headers, rows, hide) {
    const keep = headers
      .map((h, i) => i)
      .filter((i) => !hide.includes(headers[i].trim().toLowerCase()));
    headers = keep.map((i) => headers[i]);
    rows = rows.map((r) => keep.map((i) => r[i] ?? ''));
    // Centre a column only when every value in it is a number, so scores and points line
    // up while dates, names and free text stay left-aligned.
    const NUMERIC = /^-?\d+(\.\d+)?$/;
    const isNum = headers.map((_, i) => {
      const vals = rows.map((r) => (r[i] ?? '').trim()).filter((v) => v !== '' && !PLACEHOLDER.test(v));
      return vals.length > 0 && vals.every((v) => NUMERIC.test(v));
    });

    const t = el('table');
    if (headers.length > 8) t.className = 'wide';
    const thead = el('thead'), htr = el('tr');
    headers.forEach((h, i) => {
      const th = el('th', h);
      if (isNum[i]) th.className = 'num';
      htr.appendChild(th);
    });
    thead.appendChild(htr); t.appendChild(thead);
    const tb = el('tbody');
    rows.forEach((r) => {
      const tr = el('tr');
      headers.forEach((_, i) => {
        const td = el('td', r[i] ?? '');
        if (isNum[i]) td.className = 'num';
        tr.appendChild(td);
      });
      tb.appendChild(tr);
    });
    t.appendChild(tb);
    return t;
  }

  // A section is a lone title in column A, then a header row, then rows until a blank line.
  function renderSections(rows, into, hide) {
    let i = 0;
    while (i < rows.length) {
      if (!filled(rows[i])) { i++; continue; }
      const isTitle = rows[i][0].trim() !== '' && rows[i].slice(1).every((c) => c.trim() === '');
      let title = null;
      if (isTitle) { title = rows[i][0].trim(); i++; }
      if (i >= rows.length || !filled(rows[i])) continue;
      const headers = rows[i].filter((h) => h.trim() !== ''); i++;
      const body = [];
      while (i < rows.length && filled(rows[i])) { body.push(rows[i]); i++; }
      if (title) into.appendChild(el('h4', title));
      into.appendChild(table(headers, body, hide));
    }
  }

  // Course boards put the counting leaderboard in the leftmost columns and a full score
  // history to its right, separated by one empty column. Only the counting board is public.
  function renderTable(rows, into, hide, require) {
    const headerRow = rows.findIndex((r) => r.filter((c) => c.trim() !== '').length > 2);
    if (headerRow < 0) return;
    const raw = rows[headerRow];
    let width = raw.findIndex((h) => h.trim() === '');
    if (width < 1) width = raw.length;
    const headers = raw.slice(0, width);
    // Sheets often trail off into part-filled rows; a row only counts if the columns that
    // identify it are present.
    const required = require
      .map((name) =>
        /^\d+$/.test(name) ? Number(name) : headers.findIndex((h) => h.trim().toLowerCase() === name)
      )
      .filter((i) => i >= 0 && i < headers.length);
    const body = rows
      .slice(headerRow + 1)
      .map((r) => r.slice(0, width))
      .filter(filled)
      .filter((r) => required.every((i) => (r[i] ?? '').trim() !== ''));
    into.appendChild(table(headers, body, hide));
  }

  // Standard bracket slot order, so the top two seeds can only meet in the final.
  const seedOrder = (n) => {
    let a = [1];
    while (a.length < n) { const m = a.length * 2 + 1; a = a.flatMap((s) => [s, m - s]); }
    return a;
  };

  function markCut(body, bye, playoff) {
    const rows = [...body.querySelectorAll('tbody tr')];
    if (!rows.length) return;
    rows.forEach((tr, i) => {
      if (i < bye) tr.classList.add('is-bye');
      else if (i < playoff) tr.classList.add('is-playoff');
    });

    const legend = el('div');
    legend.className = 'cut-legend';
    legend.innerHTML =
      `<span><i class="sw bye"></i>Top ${bye} — Quarterfinal bye</span>` +
      `<span><i class="sw play"></i>Seeds ${bye + 1}\u2013${playoff} — into the bracket</span>`;
    body.insertBefore(legend, body.firstChild);

    const names = rows.slice(0, playoff).map((tr) => tr.children[1]?.textContent.trim() || '?');
    if (names.length === playoff) body.appendChild(bracket(names, bye));
  }

  function bracket(names, byes) {
    const n = names.length;
    const seed = (s) => `<b>${s}</b> ${names[s - 1]}`;
    const firstPairs = [];
    for (let i = 0; byes + 1 + i < n - i; i++) firstPairs.push([byes + 1 + i, n - i]);

    const round = (title, matches) =>
      `<div class="rd"><h5>${title}</h5>${matches
        .map((m) => `<div class="mt">${m.map((side) => `<div>${side}</div>`).join('')}</div>`)
        .join('')}</div>`;

    const first = firstPairs.map(([a, b]) => [seed(a), seed(b)]);
    const qf = seedOrder(byes).map((s) => {
      const [a, b] = firstPairs[byes - s];
      return [seed(s), `<i>Winner ${a} v ${b}</i>`];
    });
    const sf = [];
    for (let i = 0; i < qf.length / 2; i++) {
      sf.push([`<i>Winner QF${i * 2 + 1}</i>`, `<i>Winner QF${i * 2 + 2}</i>`]);
    }

    const wrap = el('div');
    wrap.className = 'bracket';
    wrap.innerHTML =
      `<h4>Projected bracket</h4>` +
      `<p class="bracket-note">Seeding as the board stands right now — it moves with every result.</p>` +
      `<div class="rounds">` +
      round('First Round', first) +
      round('Quarterfinals', qf) +
      round('Semifinals', sf) +
      round('Final', [[`<i>Winner SF1</i>`, `<i>Winner SF2</i>`]]) +
      `</div>`;
    return wrap;
  }

  document.querySelectorAll('[data-standings]').forEach((root) => {
    const base = root.dataset.csvBase;
    const hide = (root.dataset.hide || '').split('|').filter(Boolean).map((s) => s.toLowerCase());
    const lower = (s) => (s || '').split('|').filter(Boolean).map((v) => v.toLowerCase());
    root.querySelectorAll('.board').forEach((board) => {
      let loaded = false;
      const load = async () => {
        if (loaded) return;
        loaded = true;
        const body = board.querySelector('.board-body');
        try {
          const res = await fetch(`${base}?gid=${board.dataset.gid}&single=true&output=csv`);
          if (!res.ok) throw new Error(res.status);
          const rows = parseCsv(await res.text());
          body.textContent = '';
          board.dataset.mode === 'table'
            ? renderTable(rows, body, hide, lower(board.dataset.require))
            : renderSections(rows, body, hide);
          const cut = (board.dataset.cut || '').split('|').map(Number).filter((n) => n > 0);
          if (cut.length === 2) markCut(body, cut[0], cut[1]);
        } catch {
          loaded = false;
          body.innerHTML =
            '<p class="board-status">Couldn\'t load this board just now — open the sheet directly.</p>';
        }
      };
      if (board.open) load();
      board.addEventListener('toggle', () => board.open && load());
    });
  });
</script>
