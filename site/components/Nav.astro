---
import { getCollection } from 'astro:content';
import { NAV, matchesGroup } from '../lib/nav.mjs';
import { withBase } from '../lib/base.mjs';
import { SCORING_APP } from '../lib/links.mjs';

const byCollection = {
  pages: await getCollection('pages'),
  competitions: await getCollection('competitions'),
};

const href = (group, entry) =>
  group.collection === 'competitions' ? withBase(`/competitions/${entry.data.slug}`) : withBase(`/${entry.id}`);

const groups = NAV.map((group) => ({
  group,
  entries: (byCollection[group.collection] ?? [])
    .filter((entry) => matchesGroup(entry.id, group))
    .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)),
})).filter(({ entries }) => entries.length > 0);
---
<nav>
  <a href={withBase("/")}>Start Here</a>
  {groups.map(({ group, entries }) => (
    entries.length === 1 ? (
      <a href={href(group, entries[0])}>{group.group}</a>
    ) : (
      <div class="nav-item">
        <span class="nav-top">{group.group} ▾</span>
        <div class="dropdown">
          {entries.map((entry) => (
            <a href={href(group, entry)}>{entry.data.title}</a>
          ))}
          {group.group === 'Competitions' && (
            <a href={withBase('/roll-of-honour')}>Roll of Honour</a>
          )}
        </div>
      </div>
    )
  ))}
  <a class="nav-scoring" href={`${SCORING_APP}/submit`}>Post a Score</a>
</nav>
