---
import Base from './Base.astro';
const { frontmatter } = Astro.props;
const { title, subtitle, quickFacts = [], heroImage } = frontmatter;
---
<Base title={`${frontmatter.title} — STROH's`} description={frontmatter.subtitle}>
  <header class="page-hero">
    {heroImage && <img src={heroImage} alt={title} style="max-height:160px; width:auto; display:block; margin:0 auto 20px;" />}
    <h1>{title}</h1>
    <p class="subtitle">{subtitle}</p>
  </header>
  <div class="two-col">
    <div class="prose">
      <slot />
    </div>
    <aside class="aside">
      <div class="panel">
        <h4>Quick Facts</h4>
        <div class="facts-stack">
          {quickFacts.map((f) => (
            <div class="fact">
              <span class="fact-label">{f.label}</span>
              <span class="fact-value">{f.link ? <a href={f.link}>{f.value}</a> : f.value}</span>
            </div>
          ))}
        </div>
      </div>
    </aside>
  </div>
</Base>
