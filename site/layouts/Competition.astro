---
import Base from './Base.astro';
import Standings from '../components/Standings.astro';
import { withBase } from '../lib/base.mjs';
import { SCORING_APP } from '../lib/links.mjs';
const { frontmatter } = Astro.props;
const {
  title,
  slug = 'muni-tour',
  tagline,
  summary,
  hero,
  accent = '#002060',
  keyFacts = [],
  outputs = ['page'],
  standings,
  standingsUrl,
} = frontmatter;
const downloads = withBase(`/downloads/${slug}`);
const hasPdf = outputs.includes('pdf');
const hasPng = outputs.includes('png');
const hasSlides = outputs.includes('slides');
---
<Base title={`${title} — STROH's`} description={tagline}
      shareImage={hasPng ? `/downloads/${slug}.png` : undefined}>
  <article class="competition" style={`--accent:${accent}`}>
    <header class="comp-hero">
      {hero && <img class="comp-hero-art" src={withBase(hero)} alt={title} />}
      <h1>{title}</h1>
      {tagline && <p class="tagline">{tagline}</p>}
    </header>

    <div class="two-col">
      <div class="prose">
        <slot />
        {standings && (
          <>
            <h2 id="standings">Standings</h2>
            <Standings csvBase={standings.csvBase} boards={standings.boards}
              hideColumns={standings.hideColumns} sheetUrl={standingsUrl}
              sheetLabel={`${title} leaderboard`} />
          </>
        )}
      </div>

      <aside class="aside">
        {keyFacts.length > 0 && (
          <div class="panel">
            <h4>Key Facts</h4>
            <div class="facts-stack">
              {keyFacts.map((f) => (
                <div class="fact">
                  <span class="fact-label">{f.label}</span>
                  <span class="fact-value">{f.value}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <div class="panel scoring">
          <h4>Post a Score</h4>
          <p class="small">
            Sign in with Discord and post your rounds. The standings on this page come straight
            from it.
          </p>
          <nav class="doc-links" aria-label="Scoring app">
            <a href={`${SCORING_APP}/submit`}>Submit a score</a>
            <a href={standingsUrl ?? SCORING_APP}>Live leaderboard</a>
          </nav>
        </div>

        {(hasPdf || hasPng || hasSlides) && (
          <div class="panel">
            <h4>Documents</h4>
            <nav class="doc-links" aria-label="Downloads">
              {hasPdf && <a href={`${downloads}.pdf`}>One-pager (PDF)</a>}
              {hasPng && <a href={`${downloads}.png`}>Share image (PNG)</a>}
              {hasSlides && <a href={`${downloads}-slides.html`}>Slides</a>}
            </nav>
          </div>
        )}
      </aside>
    </div>
  </article>
</Base>
